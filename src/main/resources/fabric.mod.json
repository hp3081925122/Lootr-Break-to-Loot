{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.hp.lootr_break_to_loot.Lootr_break_to_loot"
    ],
    "client": [
      "org.hp.lootr_break_to_loot.network.ClientNetworkHandler"
    ]
  },
  "mixins": [
    "lootr_break_to_loot.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "lootr": ">=${lootr_version}"
  }
}
